# ─────────────────────────────────────────────────────────────────────────────
# Development image — hot-reload via tsx + Vite HMR
# Used by docker-compose.dev.yml
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=development
ENV DOCKER=true
ENV PORT=5000

# Install all deps (including devDeps)
COPY package.json package-lock.json ./
RUN npm ci

# Source is volume-mounted at runtime — no COPY needed here
# (see docker-compose.dev.yml volumes section)

EXPOSE 5000

CMD ["npm", "run", "dev"]
